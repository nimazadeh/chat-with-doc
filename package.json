{
  "name": "chat-with-doc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && tsx --env-file=.env src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file=.env dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "build:client": "vite build",
    "format": "prettier --write src tests *.config.ts *.json index.html .github",
    "format:check": "prettier --check src tests *.config.ts *.json index.html .github"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide": "^1.61.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
