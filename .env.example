# Choose your own six ASCII digits; this placeholder intentionally prevents startup.
ACCESS_CODE=REPLACE_WITH_SIX_DIGITS
PORT=3000
# Exact browser origin, no trailing slash. Non-loopback hosts require HTTPS.
APP_ORIGIN=http://localhost:3000

# Extracted sources only; original PDFs are discarded. Keep this outside Git.
DATA_DIR=.data

# Optional AI chat. Leave unset until you want content sent to a provider.
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=YOUR_SERVER_ONLY_KEY
# AI_TIMEOUT_MS=20000
# For the supported OpenAI-compatible chat-completions contract instead:
# AI_PROVIDER=openai-compatible
# AI_MODEL=YOUR_COMPATIBLE_MODEL
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=YOUR_SERVER_ONLY_KEY
